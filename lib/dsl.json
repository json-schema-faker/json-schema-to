{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DSL",
  "$defs": {
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$id": {
          "type": "string",
          "pattern": "[A-Z][a-z0-9]+"
        },
        "$defs": {
          "type": "object"
        }
      },
      "required": [
        "$id",
        "$defs"
      ]
    },
    "Service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$id": {
          "type": "string",
          "pattern": "[A-Z][a-z0-9]+"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "calls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "get": {
                    "type": "string"
                  },
                  "set": {
                    "type": "string"
                  },
                  "resp": {
                    "type": "string"
                  },
                  "query": {
                    "type": ["boolean", "null"]
                  },
                  "input": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "patternProperties": {
                          "[a-zA-Z][a-zA-Z0-9]*": {
                            "type": "string",
                            "pattern": "[A-Z][a-z0-9]+"
                          }
                        }
                      }
                    ]
                  },
                  "params": {
                    "type": "string"
                  },
                  "required": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "[A-Z][a-z0-9]+"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "calls"
          ]
        },
        "$defs": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "[A-Z][a-z0-9]+": {
              "type": "object",
              "properties": {
                "properties": {
                  "type": "object"
                },
                "required": {
                  "type": "array"
                },
                "items": {
                  "type": "object"
                },
                "type": {
                  "type": "string"
                },
                "$ref": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "$id",
        "service"
      ]
    },
    "Model": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "$id": {
              "type": "string",
              "pattern": "[A-Z][a-z0-9]+"
            },
            "options": {
              "type": "object"
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "type": "array"
            }
          },
          "required": [
            "$id",
            "properties"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "string"
            }
          },
          "required": ["$ref"]
        }
      ]
    }
  }
}
